/*
   AQL Query: Get assets, associated with a specific bestek and assettype

   Parameters:
   - @eDeltaDossiernummer: The bestek identifier (eDeltaDossiernummer, e.g., "HVV.089")
   - @typeURI: assettype URI

   Returns: Unique list of assets, assettypes and bestekken
*/
FOR bk IN bestekkoppelingen
  FILTER bk.status IN ['actief', 'toekomstig']
  FILTER bk._to != null
  LET bestek_doc = DOCUMENT(bk._to)
  FILTER bestek_doc != null
  FILTER bestek_doc.eDeltaDossiernummer != null
  FILTER bestek_doc.eDeltaDossiernummer == @eDeltaDossiernummer
  LET asset_doc = DOCUMENT(bk._from)
  FILTER asset_doc != null
  FILTER asset_doc.AIMDBStatus_isActief == true
  FILTER asset_doc.assettype_key != null
  LET at = DOCUMENT(CONCAT("assettypes/", asset_doc.assettype_key))
  FILTER at != null
  FILTER at.uri == @typeURI
  COLLECT
    asset_key = asset_doc._key,
    asset_naam = asset_doc.AIMNaamObject_naam,
    assettype_short_uri = at.short_uri
  INTO bestek_variable
  LET bestek_aantal = LENGTH(bestek_variable)
  FILTER bestek_aantal != 1
  LET bestek_details = (
    FOR b IN bestek_variable
    RETURN {
      dossierNummer: b.bestek_doc.eDeltaDossiernummer,
      bestekNummer: b.bestek_doc.eDeltaBesteknummer
    }
  )

  SORT assettype_short_uri asc, bestek_aantal desc

  RETURN {
    // asset info
    "a.uuid": asset_key,
    "a.naam": asset_naam,
    "a.typeURI": assettype_short_uri,
    "aantal_bestekken": bestek_aantal,
    //"bestek_info": bestek_variable,
    "bestek_details": CONCAT_SEPARATOR(";", bestek_details),
  }