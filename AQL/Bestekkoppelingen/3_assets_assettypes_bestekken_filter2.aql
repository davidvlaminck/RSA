/*
   AQL Query: Get assets, associated with a specific bestek and assettype

   Parameters:
   - @eDeltaDossiernummer: The bestek identifier (eDeltaDossiernummer, e.g., "HVV.089")
   - @typeURI: assettype URI

   Returns: Unique list of assets, assettypes and bestekken
*/
LET target_bestek = FIRST(
  FOR b IN bestekken
    FILTER b.eDeltaDossiernummer == @eDeltaDossiernummer
    FILTER b.actief == true
    LIMIT 1
    RETURN b
)
FILTER target_bestek != null

/* Traverse INBOUND via bestekkoppelingen edge index */
FOR asset_doc IN 1..1 INBOUND target_bestek._id bestekkoppelingen
  FILTER asset_doc.AIMDBStatus_isActief == true
  FILTER asset_doc.assettype_key != null

  /* Join assettypes via persistent index on _key */
  LET at = DOCUMENT(CONCAT("assettypes/", asset_doc.assettype_key))
  FILTER at.uri == @typeURI

  COLLECT
    asset_key = asset_doc._key,
    asset_naam = asset_doc.AIMNaamObject_naam,
    assettype_short_uri = at.short_uri
  INTO group_variable
  LET bestek_koppeling = group_variable[0].asset_doc.bs.Bestek_bestekkoppeling
  LET bestek_aantal = LENGTH(bestek_koppeling)
  FILTER bestek_aantal != 1


  LET bestek_details = (
    FOR bk IN bestek_koppeling
    // dossier- en besteknummer zoeken in de geneste json van de asset zelf.
    RETURN {
      categorie: SPLIT(bk.DtcBestekkoppeling_categorie, '/')[-1],
      dossierNummer: target_bestek.eDeltaDossiernummer,
      bestekNummer: target_bestek.eDeltaBesteknummer,
      startKoppeling: bk.DtcBestekkoppeling_actiefVan,
      eindKoppeling: bk.DtcBestekkoppeling_actiefVan,
    }
  )

  SORT assettype_short_uri asc, bestek_aantal desc

  RETURN {
    "a.uuid": asset_key,
    "a.naam": asset_naam,
    "a.typeURI": assettype_short_uri,
    "aantal_bestekken": bestek_aantal,
    "bestek_details": concat_separator(",",bestek_details)
  }