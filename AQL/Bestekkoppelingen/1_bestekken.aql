/*
   AQL Query: Get all bestekken

   Parameters:
   None

   Returns: Unique list of bestekken
*/
FOR b IN bestekken
  // DEVELOPMENT - beperk tot één bestek
  // FILTER b.eDeltaDossiernummer == @eDeltaDossiernummer
  FILTER b.actief == true

  /* Tel het aantal bestekkoppelingen dat aan ieder bestek hangt */
  LET koppelingen = (
    FOR bk IN 1..1 INBOUND b._id bestekkoppelingen
      FILTER bk.status in ['actief', 'toekomstig']
      RETURN bk
  )
  LET koppelingen_aantal = LENGTH(koppelingen)
  SORT koppelingen_aantal desc

  RETURN {
    // info bestek
    "uuid": b.uuid,
    "type": b.type,
    "awvId": b.awvId,
    "dossiernummer": b.eDeltaDossiernummer,
    "besteknummer": b.eDeltaBesteknummer,
    "naamAannemer": b.aannemerNaam,
    "referentieAannemer": b.aannemerReferentie,
    "actief": b.actief,
    "aantal_koppelingen": koppelingen_aantal
  }