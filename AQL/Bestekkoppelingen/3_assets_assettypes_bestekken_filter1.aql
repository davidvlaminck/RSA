/*
   AQL Query: Get assets, associated with a specific bestek and assettype

   Parameters:
   - @typeURI: assettype URI

   Returns: Unique list of assets, assettypes and bestekken
*/
LET at_key = FIRST(
  FOR at IN assettypes
    FILTER at.uri == @typeURI
    LIMIT 1
    RETURN at._key
)
FILTER at_key != null

FOR asset_doc IN assets
  FILTER asset_doc.AIMDBStatus_isActief == true
  FILTER asset_doc.assettype_key == at_key

  /* Get bestekkoppelingen from embedded array (no traversal needed) */
  LET bestek_koppeling = asset_doc.bs.Bestek_bestekkoppeling
  FILTER bestek_koppeling != null

  LET bestek_aantal = LENGTH(bestek_koppeling)
  FILTER bestek_aantal > 0

  /* Resolve bestek documents for details */
  LET bestek_details = (
    FOR bk IN bestek_koppeling
    LET bestek_doc = DOCUMENT(bk._to)
    FILTER bestek_doc != null
    RETURN {
      categorie: SPLIT(bk.DtcBestekkoppeling_categorie, '/')[-1],
      dossierNummer: bestek_doc.eDeltaDossiernummer,
      bestekNummer: bestek_doc.eDeltaBesteknummer,
      startKoppeling: bk.DtcBestekkoppeling_actiefVan,
      eindKoppeling: bk.DtcBestekkoppeling_actiefTot,
    }
  )

  COLLECT
    asset_key = asset_doc._key,
    asset_naam = asset_doc.AIMNaamObject_naam,
    assettype_short_uri = FIRST(FOR at IN assettypes FILTER at._key == at_key RETURN at.short_uri)
  INTO grouped

  LET all_bestek_details = FLATTEN(grouped[*].bestek_details)
  LET total_bestek_count = LENGTH(all_bestek_details)

  SORT assettype_short_uri ASC, total_bestek_count DESC

  RETURN {
    "a.uuid": asset_key,
    "a.naam": asset_naam,
    "a.typeURI": assettype_short_uri,
    "aantal_bestekken": total_bestek_count,
    "bestek_details": concat_separator(",", all_bestek_details)
  }
