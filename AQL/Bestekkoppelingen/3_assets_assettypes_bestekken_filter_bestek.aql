/*
   AQL Query: Get assets, associated with a specific bestek and assettype

   Parameters:
   - @eDeltaDossiernummer: The bestek identifier (eDeltaDossiernummer, e.g., "HVV.089")

   Returns: Unique list of assets, assettypes and bestekken
*/
LET target_bestek = FIRST(
  FOR b IN bestekken
    FILTER b.eDeltaDossiernummer == @eDeltaDossiernummer
    FILTER b.actief == true
    LIMIT 1
    RETURN b
)
FILTER target_bestek != null

FOR asset_doc IN assets
  FILTER asset_doc.AIMDBStatus_isActief == true
  FILTER asset_doc.assettype_key != null

  /* Filter assets op basis van assettypes */
  LET at = DOCUMENT(CONCAT("assettypes/", asset_doc.assettype_key))

  /* Filter assets op basis van bestekkoppelingen */
  LET bs_bestekkoppeling = asset_doc.bs.Bestek_bestekkoppeling
  LET bs_bestekkoppeling_filtered = bs_bestekkoppeling == null ? null : (
    for bk in bs_bestekkoppeling
      // filter status is actief
      FILTER bk.status IN ['actief', 'toekomstig']
      // filter bestek is target bestek
      FILTER bk._to == target_bestek._id
      RETURN bk
  )
  LET bk_aantal = LENGTH(bs_bestekkoppeling_filtered)

  // FILTER bk_aantal >= 1

  LET bestek_details = bk_aantal >= 1 ? (
    FOR bk IN bs_bestekkoppeling_filtered
    LET bestek_doc = DOCUMENT(bk._to)
    FILTER bestek_doc != null
    RETURN {
      categorie: SPLIT(bk.DtcBestekkoppeling_categorie, '/')[-1],
      dossierNummer: bestek_doc.eDeltaDossiernummer,
      bestekNummer: bestek_doc.eDeltaBesteknummer,
      startKoppeling: bk.DtcBestekkoppeling_actiefVan,
      eindKoppeling: bk.DtcBestekkoppeling_actiefTot,
    }
  ) : null

  /* Aantal items per categorie */
  LET bk_aantal_werkbestek = bk_aantal >= 1 ? LENGTH(
    FOR bk IN bestek_details
      FILTER bk.categorie == 'werkbestek'
      RETURN bk
  ) : null
  LET bk_aantal_aanleverbestek = bk_aantal >= 1 ? LENGTH(
    FOR bk IN bestek_details
      FILTER bk.categorie == 'aanleverbestek'
      RETURN bk
  ) : null

  /* Categorie van het eerste element (indien aanwezig) */
  LET bk_eerste_categorie = bestek_details == null || LENGTH(bestek_details) == 0
    ? null
    : bestek_details[0].categorie

  SORT at.short_uri asc, bk_aanta desc

  RETURN {
    "uuid": asset_doc._key,
    "naam": asset_doc.AIMNaamObject_naam,
    "toestand": asset_doc.toestand,
    "assettype": at.short_uri,
    "filter_bestek_eDeltaDossiernummer": target_bestek.eDeltaDossiernummer,
    "bk_aantal": bk_aantal,
    "bk_aantal_werkbestek": bk_aantal_werkbestek,
    "bk_aantal_aanleverbestek": bk_aantal_aanleverbestek,
    "bk_eerste_categorie": bk_eerste_categorie,
    "bk_details": concat_separator(",", bestek_details),
  }
