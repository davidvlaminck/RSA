// AQL query:
RETURN {
	aansluitingen: LENGTH(aansluitingen),
	aansluitingrefs: LENGTH(aansluitingrefs),
	agents: LENGTH(agents),
	assetrelaties: LENGTH(assetrelaties),
	assets: LENGTH(assets),
	assettypes: LENGTH(assettypes),
	beheerders: LENGTH(beheerders),
	bestekken: LENGTH(bestekken),
	bestekkoppelingen: LENGTH(bestekkoppelingen),
	betrokkenerelaties: LENGTH(betrokkenerelaties),
	bevestiging_relaties: LENGTH(bevestiging_relaties),
	connections: LENGTH(connections),
	gemigreerdnaar_relaties: LENGTH(gemigreerdnaar_relaties),
	heeftkeuring_relaties: LENGTH(heeftkeuring_relaties),
	hoortbij_relaties: LENGTH(hoortbij_relaties),
	identiteiten: LENGTH(identiteiten),
	params: LENGTH(params),
	places: LENGTH(places),
	relatietypes: LENGTH(relatietypes),
	sturing_relaties: LENGTH(sturing_relaties),
	toezichtgroepen: LENGTH(toezichtgroepen),
	voedt_relaties: LENGTH(voedt_relaties),
	vplankoppelingen: LENGTH(vplankoppelingen),
}