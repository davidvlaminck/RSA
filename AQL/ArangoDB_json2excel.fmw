INCLUDE PYTHON
def ParamFunc():
  import fme
  from pathlib import Path

  def get_root_folder_name():
      """
      Retrieves the name of the root folder.

      Returns:
          str: The name of the root folder.
      """
      root_folder = fme.macroValues['ROOT_FOLDER']
      root_folder_path = Path(root_folder)
      return root_folder_path.name

  return get_root_folder_name()
value = ParamFunc()
macroName = 'ROOT_FOLDER_NAME'
if value == None:
  return { macroName : u'' }
else:
  import six
  try:
    value = six.text_type(value)
  except UnicodeDecodeError:
    value = six.text_type(value, 'utf-8')
  return { macroName : value }
END_INCLUDE
DEFAULT_MACRO SourceDataset_JSON $(ROOT_FOLDER)/*.json

DEFAULT_MACRO DestDataset_XLSXW $(ROOT_FOLDER)/$(ROOT_FOLDER_NAME).xlsx

