FACTORY_DEF * TeeFactory    FACTORY_NAME "JSONFeature_JSON_1 Splitter"    INPUT FEATURE_TYPE JSONFeature    OUTPUT FEATURE_TYPE JSONFeature_JSON_1
DEFAULT_MACRO WB_CURRENT_CONTEXT
